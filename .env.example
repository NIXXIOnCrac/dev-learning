# Defaults: SQLite in .data/, anonymous persistent learner, guided (non-AI) tutor.
PORT=3000

# Optional PostgreSQL. Without DATABASE_URL, SQLite is used.
# DATABASE_URL=postgresql://forge:YOUR_PASSWORD@localhost:5432/forge
# Set this before running docker compose. Use a unique, long password.
# POSTGRES_PASSWORD=

# Secure, partitioned cookies for HTTPS iframe previews and deployments.
# Automatically enabled for requests forwarded with x-forwarded-proto=https.
# COOKIE_SECURE=true

# Optional OpenAI-compatible tutor. Never put this key in client-side code.
# TUTOR_API_KEY=
# TUTOR_BASE_URL=https://api.openai.com/v1
# TUTOR_MODEL=gpt-4o-mini
